{
    "name": "corporate-notify",
    "version": "1.0.0",
    "description": "Клиент уведомлений корпоративного портала",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win dir"
    },
    "author": "Corporate Portal",
    "license": "UNLICENSED",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0"
    },
    "build": {
        "appId": "ru.katusha.notify",
        "productName": "Corporate Notify",
        "win": {
            "target": "dir"
        },
        "files": [
            "main.js",
            "preload.js",
            "config.json",
            "pages/**/*",
            "assets/**/*"
        ]
    }
}